<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="dark light">
        {%- for link in relMe %}
        <link rel="me" href="{{ link }}">
        {%- endfor %}
        <title>{{ title }}</title>
        <meta name="description" content="{{ description }}">
        <link rel="stylesheet" href="/css/style.css">
    </head>

    <body>
        <header class="h-card">
            <div class="masthead">
                <img class="sabr-logo u-photo" alt="a black & white digital image in a drawn style that represents me" src="/assets/sabr-webvatar.png">
                <div class="masthead-title">
                    <a class="site-name u-url u-uid" href="https://www.everythingsabr.me">everything sabr</a>
                </div>
            </div>
            <hr class="rule">
            <nav class="site-nav" aria-label="main">
                {%- set navItems = [
                    { label: "uses", url: "/uses/" },
                    { label: "colophon", url: "/colophon/" },
                    { label: "now", url: "/now/" },
                    { label: "blog", url: "/blog/" }
                ] %}
                {%- for item in navItems %}
                <a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
                {%- endfor %}
            </nav>
            {%- if lastUpdated %}
            <p class="updated">updated {{ lastUpdated }}</p>
            {%- endif %}
        </header>

        <main>
            <h1>{{ heading or "home" }}</h1>
            {{ content | safe }}
        </main>

        <footer>
            <p>&copy; 2026 - <a href="/">sabr</a></p>
        </footer>
    </body>
</html>
