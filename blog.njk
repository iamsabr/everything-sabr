---
title: everything sabr - blog
description: me writing for me, no topic, no rules
layout: base.njk
heading: blog
---
<p>{{ description }}</p>
<ul class="post-list">
{%- for post in collections.posts | reverse %}
    <li>
        <span class="post-date">{{ post.date | readableDate }}</span>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
    </li>
{%- endfor %}
</ul>
